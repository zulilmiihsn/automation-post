# Facebook Automation Post - Configuration

# Groq API Key for AI Parsing (Optional but recommended for high-fidelity scraping)
# Get your key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_HEAVY=openai/gpt-oss-120b
GROQ_MODEL_LIGHT=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
AI_REQUEST_TIMEOUT_MS=30000
# AI_CHAT_TIMEOUT_MS=5000

# Optional NVIDIA Build endpoint (OpenAI-compatible)
# Get an API key at: https://build.nvidia.com/
# Leave AI_PROVIDER=groq to keep Groq as default.
AI_PROVIDER=groq
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL_HEAVY=z-ai/glm-5.3-flash
NVIDIA_MODEL_LIGHT=z-ai/glm-5.3-flash
NVIDIA_REASONING_EFFORT=low
# NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1

# Server Configuration
PORT=3000
# Katalog publik (Supabase etalase, opsional)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_TABLE=catalog_items
SUPABASE_BUCKET=catalog
# Local-only. Backend rejects non-loopback binding because routes currently have no user authentication.
HOST=127.0.0.1

# Browser Configuration
HEADLESS=false

# Threads publisher (Cloudflare Worker, $0). Lokal hanya push antrean, tidak publish langsung.
# THREADS_WORKER_URL=https://threads-publisher.<subdomain>.workers.dev
# THREADS_PUBLISHER_SECRET=isi-random-panjang-min-32-karakter

# ⚠️ SECURITY WARNING: 
# Do not add Facebook credentials (Email/Password) to this file or commit them.
# Facebook login is handled securely via persistent browser context during the first run.
